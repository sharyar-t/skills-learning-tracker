# Supabase project credentials (Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
# Public address of the deployed site, used for links in confirmation / password-reset emails.
# Leave empty for local development (links then point at http://localhost:3000).
NUXT_PUBLIC_SITE_URL=
SUPABASE_ACCESS_TOKEN=your-supabase-access-token